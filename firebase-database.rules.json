{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "storeData": {
      ".validate": "newData.hasChildren(['password', 'products', 'settings'])"
    },
    "adminAuth": {
      ".validate": "newData.hasChildren(['password']) && newData.child('password').isString() && newData.child('password').val().length >= 1"
    }
  }
}